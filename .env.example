# Copy this to .env.local for local development (never commit .env.local).
# On Vercel, set these under Project Settings -> Environment Variables instead.

# The single shared family passcode that gates the whole app. Pick anything
# memorable — this isn't meant to be high security, just enough to keep the
# itinerary and photos away from search engines and strangers.
SITE_PASSCODE=

# Provided automatically once you create a Blob store on Vercel and connect
# it to this project (Project Settings -> Storage -> Blob). Needed for the
# photo upload feature.
BLOB_READ_WRITE_TOKEN=
